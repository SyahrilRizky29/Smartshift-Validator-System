    {
      "parameters": {
        "jsCode": "// 1. Ambil data payload langsung dari Web Portal Form Trigger lo\nconst formInput = $('Web Portal Input Jadwal').item.json;\n\n// Ambil identitas dasar karyawan dari Form\nconst email = formInput[\"Email Karyawan\"];\nconst nama = formInput[\"Nama Lengkap\"];\nconst tanggalJangkar = formInput[\"Tanggal\"]; // Format bawaan n8n: YYYY-MM-DD (Ini hari Senin)\n\n// Ambil seluruh data database masa lalu yang ditarik oleh node Fetch Existing Schedule\nconst existingRecords = $('Fetch Existing Schedule').all();\n\n// Ambil data status aturan fitur (0 atau 1) dari node Fetch Shift Rules\nconst shiftRules = $('Fetch Shift Rules').all();\n\n// Mapping status aturan dari Sheets (Default di-set ke 1/Aktif jika node tidak terbaca)\nlet statusCekDoubleShift = 1;\nlet statusCekK3Fatigue = 1;\n\nshiftRules.forEach(rule => {\n  const dataRule = rule.json;\n  if (dataRule[\"Nama Aturan\"] === \"Cek_Double_Shift\") {\n    statusCekDoubleShift = parseInt(dataRule[\"Nilai\"]) || 0;\n  }\n  if (dataRule[\"Nama Aturan\"] === \"Cek_K3_Malam_Pagi\") {\n    statusCekK3Fatigue = parseInt(dataRule[\"Nilai\"]) || 0;\n  }\n});\n\n// Array urutan hari kerja yang divalidasi (Senin sampai Jumat)\nconst daysOfWeek = [\"Senin\", \"Selasa\", \"Rabu\", \"Kamis\", \"Jumat\"];\nconst errors = [];\n\n// =========================================================================\n// ATURAN 1: DETEKSI DOUBLE SUBMIT (Hanya jalan jika di Sheets bernilai 1)\n// =========================================================================\nif (statusCekDoubleShift === 1) {\n  // Mencari apakah di Google Sheets sudah ada baris dengan Email DAN Tanggal Senin yang sama\n  const isAlreadySubmitted = existingRecords.some(record => {\n    const dataSheets = record.json;\n    return dataSheets[\"Email\"] === email && dataSheets[\"Tanggal\"] === tanggalJangkar;\n  });\n\n  if (isAlreadySubmitted) {\n    errors.push({\n      hari: \"Seminggu\",\n      detail: `Pelanggaran Double Shift: Karyawan dengan nama ${nama} (${email}) sudah pernah mengajukan paket jadwal untuk minggu tanggal ${tanggalJangkar}. Sistem menolak pengajuan ganda!`\n    });\n  }\n}\n\n// =========================================================================\n// ATURAN 2: LOOP UTAMA VALIDASI K3 (Hanya jalan jika lolos Aturan 1 DAN K3 di Sheets bernilai 1)\n// =========================================================================\nif (errors.length === 0 && statusCekK3Fatigue === 1) {\n  for (let i = 0; i < daysOfWeek.length - 1; i++) {\n    const dayNow = daysOfWeek[i];\n    const dayNext = daysOfWeek[i + 1];\n    \n    // Ambil nilai shift yang di-input user berdasarkan pola nama field-nya\n    const shiftNow = formInput[`Shift - ${dayNow}`];\n    const shiftNext = formInput[`Shift - ${dayNext}`];\n\n    // LOGIKA K3 (Fatigue Rule): Jika hari ini Malam, lalu besoknya langsung dipaksa Pagi ATAU Siang\n    if (shiftNow === \"Malam\" && (shiftNext === \"Pagi\" || shiftNext === \"Siang\")) {\n      \n      // Hitung tanggal aslinya menggunakan Luxon berdasarkan penanda hari Senin\n      const dateNow = DateTime.fromISO(tanggalJangkar).plus({ days: i });\n      const dateNext = dateNow.plus({ days: 1 });\n      \n      // Set asumsi jam operasional shift:\n      // Shift Malam selesai jam 06:00 pagi di hari berikutnya.\n      const endShiftMalam = dateNow.plus({ days: 1 }).set({ hour: 6, minute: 0 });\n      \n      // Tentukan jam mulai kerja berdasarkan jenis shift hari berikutnya\n      let startShiftNextHour = 7; // Default Pagi mulai jam 07:00\n      if (shiftNext === \"Siang\") {\n        startShiftNextHour = 14; // Jika Siang, mulai jam 14:00\n      }\n      \n      const startShiftNext = dateNext.set({ hour: startShiftNextHour, minute: 0 });\n      \n      // Hitung selisih durasi istirahat karyawan\n      const restHours = startShiftNext.diff(endShiftMalam, 'hours').hours;\n\n      // Jika jarak istirahat terbukti kurang dari 12 jam, kunci sebagai pelanggaran\n      if (restHours < 12) {\n        errors.push({\n          hari: `${dayNow} ke ${dayNext}`,\n          detail: `Konflik K3 di hari ${dayNow} ke ${dayNext}: Anda mengambil Shift Malam pada ${dateNow.toISODate()} (selesai jam 06:00), lalu besoknya hari ${dayNext} langsung masuk Shift ${shiftNext} pada ${dateNext.toISODate()} (mulai jam ${startShiftNextHour.toString().padStart(2, '0')}:00). Jarak istirahat hanya ${restHours} jam (Kurang dari 12 jam).`\n        });\n      }\n    }\n  }\n}\n\n// 3. Output final terstruktur untuk dikonsumsi Node IF berikutnya\nreturn [{\n  json: {\n    isConflict: errors.length > 0, // Bernilai true jika terdeteksi pelanggaran, false jika aman bersih\n    conflictReason: errors.length > 0 ? errors[0].detail : \"Aman\", // Ambil pesan error pertama jika ada\n    allConflicts: errors, // Menyimpan list semua konflik kalau-kalau ada lebih dari satu pelanggaran\n    submittedData: formInput, // Mengoper seluruh data asli form untuk kebutuhan append database Sheets nanti\n    generatedID: `SFT-${DateTime.fromISO(tanggalJangkar).toFormat('yyyyMMdd')}-${Math.floor(100 + Math.random() * 900)}` // ID unik mingguan\n  }\n}];"
      },
