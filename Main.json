    {
      "parameters": {
        "jsCode": "// 1. Inisialisasi Data dari Node-Node sebelumnya\nconst formInput = $('Web Portal Input Jadwal').item.json; // Data dari Form\nconst dbData = $items(\"Fetch Existing Schedule\");         // Seluruh jadwal di Sheets\nconst rulesData = $items(\"Fetch Shift Rules\");            // Aturan ON/OFF dari Sheets\n\nlet conflict = false;\nlet reason = \"\";\n\n// 2. Mapping Aturan (Mengubah list dari Sheets jadi objek agar mudah dibaca)\nconst rules = {};\nrulesData.forEach(item => {\n    // rules[\"Nama_Aturan\"] = 1 atau 0\n    rules[item.json[\"Nama Aturan\"]] = parseInt(item.json[\"Nilai\"]);\n});\n\n// 3. Standarisasi Format Data untuk Perbandingan\nconst inputDate = DateTime.fromISO(formInput.Tanggal).toISODate(); // Format YYYY-MM-DD\nconst inputNama = String(formInput.Nama || '').trim().toLowerCase(); // Nama kecil semua\nconst yesterdayISO = DateTime.fromISO(formInput.Tanggal).minus({ days: 1 }).toISODate(); // H-1 dari input\n\n// 4. LOOP UTAMA: Mengecek input Form terhadap setiap baris di Database\nfor (const row of dbData) {\n    const db = row.json;\n    if (!db.Nama || !db.Tanggal) continue; // Skip jika baris kosong\n\n    // Konversi tanggal database ke YYYY-MM-DD agar sinkron dengan input\n    let dbDate;\n    try {\n        const rawDate = String(db.Tanggal).trim();\n        dbDate = rawDate.includes('/') ? DateTime.fromFormat(rawDate, 'd/M/yyyy').toISODate() : DateTime.fromISO(rawDate).toISODate();\n    } catch (e) { continue; }\n\n    const dbNama = String(db.Nama).trim().toLowerCase();\n\n    // 5. CEK DOUBLE SHIFT (Dilakukan jika aturan di Sheets bernilai 1)\n    if (rules[\"Cek_Double_Shift\"] === 1 && dbNama === inputNama && dbDate === inputDate) {\n        conflict = true;\n        \n        // Logika tambahan: Membedakan alasan penolakan\n        if (db.Shift === formInput.Shift) {\n            // Jika tanggal sama DAN shift-nya sama (biasanya user tidak sengaja klik submit 2x)\n            reason = `Input Ganda: Anda SUDAH terdaftar di Shift ${db.Shift} untuk tanggal ${db.Tanggal}. Tidak perlu input lagi ya.`;\n        } else {\n            // Jika tanggal sama tapi mau ambil shift beda (misal pagi mau lanjut siang)\n            reason = `Sistem Menolak: Anda sudah terdaftar di Shift ${db.Shift} pada tanggal ${db.Tanggal}. Kebijakan perusahaan melarang Double Shift di hari yang sama.`;\n        }\n        break; // Berhenti mencari karena sudah ketemu konflik\n    }\n\n    // 6. CEK K3 (Malam ke Pagi - Dilakukan jika aturan di Sheets bernilai 1)\n    if (rules[\"Cek_K3_Malam_Pagi\"] === 1 && dbNama === inputNama && dbDate === yesterdayISO && db.Shift === 'Malam' && formInput.Shift === 'Pagi') {\n        conflict = true;\n        reason = `Sistem Menolak: Pelanggaran K3. Anda masuk Malam pada ${db.Tanggal}, wajib istirahat minimal 12 jam sebelum ambil shift Pagi.`;\n        break; // Berhenti mencari\n    }\n}\n\n// 7. Output Final untuk dikirim ke node \"Validation Checker\"\nreturn [{\n    json: {\n        isConflict: conflict,\n        conflictReason: reason,\n        submittedData: formInput,\n        generatedID: `SFT-${DateTime.fromISO(formInput.Tanggal).toFormat('yyyyMMdd')}-${Math.floor(100 + Math.random() * 900)}`\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
